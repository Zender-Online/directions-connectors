{
  "$id": "catalog.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "connector": {
          "type": "string",
          "const": "curated"
        },
        "datasets": {
          "minItems": 1,
          "maxItems": 500,
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "publisher": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "terms": {
                    "minItems": 1,
                    "maxItems": 60,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z0-9_]+$"
                    }
                  },
                  "acronym": {
                    "type": "string",
                    "pattern": "^[a-z0-9_]+$"
                  },
                  "measurement": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "endpoint": {
                    "type": "string",
                    "maxLength": 2000,
                    "pattern": "^https:\\/\\/"
                  },
                  "format": {
                    "type": "string",
                    "enum": [
                      "json",
                      "csv",
                      "geojson",
                      "page"
                    ]
                  },
                  "recordSelector": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "checkedAt": {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                  },
                  "updatedAt": {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                  },
                  "note": {
                    "type": "string",
                    "maxLength": 1000
                  }
                },
                "required": [
                  "id",
                  "title",
                  "publisher",
                  "terms",
                  "endpoint",
                  "format",
                  "checkedAt"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "publisher": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "terms": {
                    "minItems": 1,
                    "maxItems": 60,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z0-9_]+$"
                    }
                  },
                  "acronym": {
                    "type": "string",
                    "pattern": "^[a-z0-9_]+$"
                  },
                  "measurement": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "endpoint": {
                    "type": "null"
                  },
                  "note": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "checkedAt": {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                  }
                },
                "required": [
                  "id",
                  "title",
                  "publisher",
                  "terms",
                  "endpoint",
                  "note"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
