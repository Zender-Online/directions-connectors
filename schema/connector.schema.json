                            "maximum": 100000
                          },
                          "totalPath": {
                            "default": null,
                            "anyOf": [
                              {
                                "minItems": 1,
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "minLength": 1
                                }
                              },
                              {
                                "type": "null"
