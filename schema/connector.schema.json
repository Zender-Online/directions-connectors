            "method": {
              "default": "GET",
              "type": "string",
              "enum": [
                "GET",
                "POST"
              ]
            },
            "headers": {
              "default": {},
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              }
            },
            "params": {
              "default": {},
              "type": "object",
              "propertyNames": {
