                            "default": null,
                            "anyOf": [
                              {
                                "type": "integer",
                                "exclusiveMinimum": 0,
                                "maximum": 1000
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "totalPagesPath": {
                            "minItems": 1,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "totalRecordsPath": {
                            "minItems": 1,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        },
                        "required": [
                          "type",
                          "param"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "offset"
                          },
                          "param": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 60
                          },
                          "sizeParam": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 60
                          },
                          "size": {
                            "type": "integer",
